rules_version = '2';

// Reglas de Firestore de Burger Chao.
// Copia TODO este archivo en Firebase Console → Firestore Database → Reglas → Publicar.
//
// - orders: el cliente puede CREAR su pedido y SEGUIRLO por su ID (aleatorio, no se puede adivinar).
//   Listar, modificar o borrar pedidos (datos personales) solo el panel de cocina con sesión iniciada.
// - counters: el número de pedido diario solo puede empezar en 1 o subir de uno en uno.
// - clientes (publicidad): la web solo puede dar de ALTA a quien acepta; ver la lista, dar de baja
//   o borrar solo el admin.

service cloud.firestore {
  match /databases/{database}/documents {

    // Admin = la cuenta con la que se entra en el panel de cocina (correo y contraseña).
    // Deja fuera a usuarios anónimos. Para que SOLO tu cuenta tenga acceso, sustituye la línea por:
    //   return request.auth != null && request.auth.uid == 'UID_DE_TU_CUENTA';
    // (Firebase Console → Authentication → Users → columna «User UID»).
    function isAdmin() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'password';
    }

    match /orders/{orderId} {
      allow create: if true;
      allow get:    if true;                 // seguimiento del pedido por el cliente (por su ID)
      allow list:   if isAdmin();            // ver todos los pedidos: solo cocina
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /counters/{docId} {
      allow read: if true;
      allow create, update: if docId == 'daily'
        && request.resource.data.keys().hasOnly(['date', 'count'])
        && request.resource.data.date is string
        && request.resource.data.count is int
        && (
          // Día nuevo (o primer pedido): empieza en 1
          ((resource == null || resource.data.date != request.resource.data.date)
            && request.resource.data.count == 1)
          // Mismo día: sube exactamente 1
          || (resource != null
            && resource.data.date == request.resource.data.date
            && request.resource.data.count == resource.data.count + 1)
        );
    }

    match /clientes/{tel} {
      // Solo el panel admin puede ver la lista y borrar
      allow read, delete: if isAdmin();

      // Alta desde la web: solo si el cliente ha aceptado y los datos son válidos
      allow create: if validCliente(tel) && request.resource.data.acepta == true;

      allow update: if isAdmin()
        // Cliente suscrito que vuelve a pedir: solo sube el contador de pedidos en 1
        || (request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['pedidos', 'ultimoPedido', 'actualizado'])
            && request.resource.data.pedidos == resource.data.pedidos + 1)
        // Vuelve a aceptar desde otro dispositivo
        || (validCliente(tel) && request.resource.data.acepta == true);
    }

    function validCliente(tel) {
      let d = request.resource.data;
      return tel.matches('^[0-9]{9,15}$')
        && d.keys().hasOnly(['telefono', 'nombre', 'email', 'acepta', 'consentimiento',
                             'pedidos', 'ultimoPedido', 'actualizado', 'baja'])
        && d.telefono == tel
        && d.nombre is string && d.nombre.size() <= 80
        && (!('email' in d) || (d.email is string && d.email.size() <= 120))
        && d.consentimiento is map
        && d.pedidos is int;
    }
  }
}
